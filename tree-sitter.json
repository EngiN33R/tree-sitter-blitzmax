{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [{
    "name": "blitzmax",
    "camelcase": "BlitzMax",
    "scope": "source.blitzmax",
    "path": ".",
    "file-types": ["bmx"],
    "injection-regex": "^blitzmax$",
    "highlights": "queries/highlights.scm"
  }],
  "metadata": {
    "version": "0.1.1",
    "license": "MIT",
    "description": "Case-insensitive Tree-sitter grammar for BlitzMax NG",
    "authors": [{ "name": "Ilya Gavrikov" }],
    "links": { "repository": "https://github.com/EngiN33R/tree-sitter-blitzmax" }
  },
  "bindings": { "c": true, "go": true, "node": true, "python": true, "rust": true, "swift": true }
}
